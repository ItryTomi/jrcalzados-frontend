# ---------------------------------------------------------------
# Mercado Pago  (obligatorio para cobrar)
# https://www.mercadopago.com.ar/developers/panel/app
#   TEST-... para probar sin plata real | APP_USR-... para cobrar
# ---------------------------------------------------------------
MP_ACCESS_TOKEN=

# Opcional pero recomendado: valida que el webhook venga de Mercado Pago.
# Se genera en el panel de MP > Webhooks > "Clave secreta".
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Base de datos  (para guardar los pedidos)
# Neon: https://neon.tech  -> plan free, permite uso comercial
# Copiar la "Connection string" con ?sslmode=require
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Aviso de venta por mail  (opcional)
# Resend: https://resend.com -> plan free 3.000 mails/mes
# ---------------------------------------------------------------
RESEND_API_KEY=
MAIL_AVISOS=
MAIL_REMITENTE=JR Calzados <onboarding@resend.dev>

# ---------------------------------------------------------------
# Para consultar GET /api/pedidos. Inventar una cadena larga al azar.
# ---------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------
# Cloudinary  (fotos de producto)
# https://cloudinary.com -> Dashboard
# El "cloud name" es publico; API key/secret NO se comparten.
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
